# Copy this file to .env and fill in your own values.
# This local version is run separately by each streamer on their own PC.
SOOP_CLIENT_ID=
SOOP_CLIENT_SECRET=
SOOP_REDIRECT_URL=http://127.0.0.1:3000/oauth/callback

# Must match the token configured in your own SMAPI mod.
STARDEW_BRIDGE_URL=http://127.0.0.1:8765/event
STARDEW_BRIDGE_TOKEN=

PORT=3000
