# Copy this file to .env and fill in your own values.
# This local version is run separately by each streamer on their own PC.
SOOP_CLIENT_ID=
SOOP_CLIENT_SECRET=
SOOP_REDIRECT_URL=http://127.0.0.1:3000/oauth/callback

# Must match the token configured in your own SMAPI mod.
STARDEW_BRIDGE_URL=http://127.0.0.1:8765/event
STARDEW_BRIDGE_TOKEN=

# Central 관리자 서버에 방송 닉네임을 알리는 설정 (선택).
# AGENT_TOKEN은 Central 관리자 페이지에서 방송 등록 시 발급된 토큰 (SMAPI 모드 config.json의 AgentToken과 같은 값).
CENTRAL_SERVER_URL=http://127.0.0.1:3001
AGENT_TOKEN=

PORT=3000
